# Copia este archivo como ".env" y completa los valores.
# Sin estas variables la app no puede iniciar sesión ni cargar el mapa.
# En Vercel se definen en Settings -> Environment Variables.

# Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Google Maps (opcional - para retraso de tráfico en vivo en rutas)
VITE_GOOGLE_MAPS_API_KEY=
